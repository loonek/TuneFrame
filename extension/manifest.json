{
  "manifest_version": 3,
  "name": "TuneFrame",
  "version": "0.1.0",
  "description": "Mirrors your YouTube Music now-playing, feed and playlists to a JC4827W543 touchscreen, and sends taps back to control playback.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["main_world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
