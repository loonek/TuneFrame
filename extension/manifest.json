{
  "manifest_version": 3,
  "name": "JC4827 Music Bridge",
  "version": "0.1.0",
  "description": "Bridges the YouTube Music player to the JC4827W543 display.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["main_world.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
